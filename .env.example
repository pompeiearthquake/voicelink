# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

# Port the server listens on (Railway sets this for you)
PORT=3000

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# One-time key used only to create the very first admin account.
# Pick your own long random value, use it once via /api/managers/bootstrap,
# then you can rotate/forget it — after the first admin exists, this
# endpoint refuses to create another account even with the right key.
ADMIN_SETUP_KEY=replace-this-with-another-long-random-string

# Folder for the SQLite database. Leave unset locally (uses ./data). On Railway, mount the volume at
# /app/data and you don't need this. If the volume is mounted elsewhere, set it to that path, e.g. /data
# — otherwise the database is wiped on redeploy.
# DATA_DIR=/data

# Set to "production" when deployed. Enables secure (HTTPS-only) cookies.
NODE_ENV=development
